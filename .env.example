# Desktop (recommended for local app)
#   pnpm desktop:dev
#   Uses embedded PostgreSQL (preferred 55432), auto-migrates on API boot.
#   Do NOT point GRAPHSCOPE_DB_* at system Postgres / Docker for desktop.

# Contributor API + web without Electron (requires external Postgres on 5432):
#   docker compose up -d   # or local brew Postgres with user/db graphscope
#   pnpm db:migrate
#   pnpm stack:dev

GRAPHSCOPE_API_PORT=47321
GRAPHSCOPE_DATA_DIR=
GRAPHSCOPE_DB_PROFILE=development
GRAPHSCOPE_DB_HOST=127.0.0.1
GRAPHSCOPE_DB_PORT=5432
GRAPHSCOPE_DB_USER=graphscope
GRAPHSCOPE_DB_PASSWORD=graphscope
GRAPHSCOPE_DB_NAME=graphscope
GRAPHSCOPE_GITHUB_CLIENT_ID=
